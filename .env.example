# Copy to .env.local. Do not commit real environment values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative if your project still uses the anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose with NEXT_PUBLIC_ or put in browser code.
SUPABASE_SERVICE_ROLE_KEY=
